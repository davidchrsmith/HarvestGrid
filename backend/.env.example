# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/harvestgrid

# The Next.js frontend origin (comma-separated for multiple)
CORS_ALLOWED_ORIGINS=http://localhost:3000
